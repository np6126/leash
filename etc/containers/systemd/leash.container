[Unit]
Description=leash — auditing egress proxy for tank-os AI agents
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/leash:latest
ContainerName=leash
Pull=newer
RunInit=true

PublishPort=0.0.0.0:8080:8080

Volume=/var/lib/leash/mitmproxy:/root/.mitmproxy:Z
Volume=/var/lib/leash/logs:/logs:Z
Volume=/etc/leash:/etc/leash:Z

Environment=LEASH_DIR=/etc/leash
Environment=LOG_PATH=/logs/egress.jsonl
Environment=BODY_LIMIT_KB=1024

# Per-VM settings, e.g. LEASH_IDENTITY_HOST — the control-plane host whose agent
# traffic gets its real source IP stamped into X-Agent-Source (see
# docs/proxmox-setup.md). Quadlet maps this to podman --env-file, which needs an
# absolute path and an existing file; setup.sh creates an empty one if unset, so
# an empty file just leaves the settings unset.
EnvironmentFile=/etc/leash/identity.env

PodmanArgs=--memory 256m

[Service]
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
